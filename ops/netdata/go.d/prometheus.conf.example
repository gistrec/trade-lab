# Netdata go.d/prometheus scraper for the trade-lab metrics exporters
# (one health server per environment, ops/health_server.py serves /metrics;
# ops/metrics.py renders it read-only from the journal).
#
# Install:
#   sudo cp ops/netdata/go.d/prometheus.conf.example /etc/netdata/go.d/prometheus.conf
#   # (if the file already exists, MERGE these jobs into its `jobs:` list)
#   sudo systemctl restart netdata   # go.d JOB changes need a restart, NOT
#                                    # just `netdatacli reload-health`
#
# Netdata auto-charts every tradelab_* series it scrapes, under the job name
# (chart context prometheus.<job>.<metric>). No per-metric config needed —
# the exporter emits only tradelab_* families.
jobs:
  - name: trade_lab
    url: http://127.0.0.1:7001/metrics

  # Mainnet instance (trade-lab-health-mainnet, port 7002) — real money.
  # Feeds the trade_lab_mainnet_* value alarms in health.d/trade_lab_metrics.conf.
  - name: trade_lab_mainnet
    url: http://127.0.0.1:7002/metrics
